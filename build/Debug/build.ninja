ers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_tim_ex.c.obj cmake/stm32cubemx/CMakeFiles/STM32_Drivers.dir/__/__/Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_usart.c.obj cmake/stm32cubemx/CMakeFiles/STM32_Drivers.dir/__/__/Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_usart_ex.c.obj cmake/stm32cubemx/CMakeFiles/STM32_Drivers.dir/__/__/Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_uart_ex.c.obj cmake/stm32cubemx/CMakeFiles/STM32_Drivers.dir/__/__/Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_uart.c.obj cmake/stm32cubemx/CMakeFiles/STM32_Drivers.dir/__/__/Drivers/BSP/STM32G4xx_Nucleo/stm32g4xx_nucleo.c.obj CMakeFiles/warehouse_proj.dir/Core/Src/main.c.obj CMakeFiles/warehouse_proj.dir/Core/Src/stm32g4xx_it.c.obj CMakeFiles/warehouse_proj.dir/Core/Src/stm32g4xx_hal_msp.c.obj CMakeFiles/warehouse_proj.dir/Core/Src/sysmem.c.obj CMakeFiles/warehouse_proj.dir/Core/Src/syscalls.c.obj CMakeFiles/warehouse_proj.dir/startup_stm32g431xx.s.obj CMakeFiles/warehouse_proj.dir/Core/Src/MCP3208.c.obj CMakeFiles/warehouse_proj.dir/Core/Src/uart_control.c.obj CMakeFiles/warehouse_proj.dir/Core/Src/robot.c.obj CMakeFiles/warehouse_proj.dir/Core/Src/motor.c.obj CMakeFiles/warehouse_proj.dir/Core/Src/encoder.c.obj CMakeFiles/warehouse_proj.dir/Core/Src/line_following.c.obj CMakeFiles/warehouse_proj.dir/Core/Src/servo.c.obj CMakeFiles/warehouse_proj.dir/Core/Src/stepper.c.obj || cmake/stm32cubemx/STM32_Drivers
  CONFIG = Debug
  FLAGS = -mcpu=cortex-m4 -mfpu=fpv4-sp-d16 -mfloat-abi=hard  -Wall -fdata-sections -ffunction-sections -fstack-usage -O0 -g
  LINK_FLAGS = -mcpu=cortex-m4 -mfpu=fpv4-sp-d16 -mfloat-abi=hard  -T "D:/Downloads/warehouse_proj/STM32G431xx_FLASH.ld" --specs=nano.specs -Wl,-Map=warehouse_proj.map -Wl,--gc-sections -Wl,--print-memory-usage
  LINK_LIBRARIES = -lm
  OBJECT_DIR = CMakeFiles\warehouse_proj.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_FILE = warehouse_proj.elf
  TARGET_PDB = warehouse_proj.elf.dbg
  TARGET_SUPPORT_DIR = CMakeFiles\warehouse_proj.dir


#############################################
# Utility command for flash

build flash: phony CMakeFiles/flash warehouse_proj.elf


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Downloads\warehouse_proj\build\Debug && "C:\Program Files\CMake\bin\cmake-gui.exe" -SD:\Downloads\warehouse_proj -BD:\Downloads\warehouse_proj\build\Debug"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Downloads\warehouse_proj\build\Debug && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SD:\Downloads\warehouse_proj -BD:\Downloads\warehouse_proj\build\Debug"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util


#############################################
# Custom command for CMakeFiles\flash

build CMakeFiles/flash | ${cmake_ninja_workdir}CMakeFiles/flash: CUSTOM_COMMAND warehouse_proj.elf || cmake/stm32cubemx/STM32_Drivers warehouse_proj.elf
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Downloads\warehouse_proj\build\Debug && "C:\Program Files\STMicroelectronics\STM32Cube\STM32CubeProgrammer\bin\STM32_Programmer_CLI.exe" -c port=SWD -w D:/Downloads/warehouse_proj/build/Debug/warehouse_proj.elf -v -rst"
  DESC = Flashing STM32 firmware

